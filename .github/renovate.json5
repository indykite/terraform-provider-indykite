{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>indykite/.github//.github/renovate.json5',
  ],
  draftPR: true,
  dependencyDashboard: {
    footer: "@indykite/be-team, @indykite/ops, here's your overview of Renovate-managed dependencies",
  },
  ignorePaths: [
    '**/vendor/**',
    '**/examples/**',
    '**/testdata/**',
  ],
  packageRules: [
    {
      matchPackageNames: [
        '*',
      ],
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'SemVer Major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'SemVer Minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
        'digest',
        'bump',
      ],
      addLabels: [
        'SemVer Patch',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'all non-major dependencies',
      groupSlug: 'all-minor-patch',
    },
  ],
  postUpdateOptions: [
    'gomodTidy',
  ],
}
